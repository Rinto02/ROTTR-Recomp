# ============================================================
# Box64 Environment Variables — ROTTR Android Configuration
# ============================================================
# Optimized dynarec settings for RE Engine / Foundation Engine
# games on ARM64 mobile devices.
#
# Source this file before launching:
#   source config/box64.env
# ============================================================

# --- Dynarec Core Settings ---

# Enable dynarec (JIT recompilation, x86_64 → ARM64)
export BOX64_DYNAREC=1

# Large block compilation for better throughput
export BOX64_DYNAREC_BIGBLOCK=3

# Safe flags handling (1 = balanced safety/performance)
export BOX64_DYNAREC_SAFEFLAGS=1

# Strong memory ordering (1 = good balance; 3 = max compat)
export BOX64_DYNAREC_STRONGMEM=1

# Weak barrier (reduces sync overhead)
export BOX64_DYNAREC_WEAKBARRIER=1

# --- Floating Point Optimizations ---

# Fast NaN handling (skip NaN checks for speed)
export BOX64_DYNAREC_FASTNAN=1

# Fast rounding (skip precision edge cases)
export BOX64_DYNAREC_FASTROUND=1

# --- Threading ---

# Thread-safe dynarec cache
export BOX64_DYNAREC_WAIT=1

# --- Memory ---

# Allow large memory mappings (needed for AAA games)
export BOX64_MMAP32=1

# --- Logging (set to 0 for release) ---
export BOX64_LOG=0
export BOX64_DYNAREC_LOG=0

# --- Vulkan ---

# Force Vulkan loader to find Turnip driver
# Adjust path based on your Turnip installation
export VK_ICD_FILENAMES=${TURNIP_DRIVER_PATH:-/data/data/com.termux/files/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json}

# --- Wine/Proton Compatibility ---

# Disable debug channels in Wine for performance
export WINEDEBUG=-all

# Force large address aware
export WINE_LARGE_ADDRESS_AWARE=1
